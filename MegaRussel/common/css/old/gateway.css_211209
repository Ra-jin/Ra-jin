/* //2020수시합격 및 만점자 middle banner */
.footer {padding-bottom:50px !important;}

/* floating banner */
.floating-banner-wrap{position:relative;width:1100px;margin:0 auto;}
.floating-banner-wrap .floating-banner{position:absolute;top:-1140px;left:540px;z-index:1;}
.floating-banner-wrap .floating-banner .banner-close{position:absolute;top:20px;right:20px;z-index:2;cursor:pointer;}

.online-banner{position:absolute;top:0;right:0;z-index:5;}
.online-close{position:absolute;top:14px;right:14px;z-index:6;cursor:pointer;}

