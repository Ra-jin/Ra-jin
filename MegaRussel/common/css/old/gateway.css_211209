/* 2021 대입합격자 현황 */
.session-tit{width:1100px;margin:40px auto 0;font-size:20px;font-weight:500;}
.session-tit span{padding-left:10px;font-size:11px;color:#cacbcb;}

.session-wrap{margin-top:15px;background:#efebf3;}
.session-wrap .session-con{position:relative;width:1100px;margin:0 auto;padding:40px 0;}
.session-wrap .session{width:1060px;margin:0 auto;box-sizing:border-box;}
.session-wrap .session-next, .session-wrap .session-prev{position:absolute;top:50%;width:20px;height:15px;margin-top:-8px;text-indent:-9999px;}
.session-wrap .session-next{right:0;background:url(http://russeldata.megastudy.net/campus/images/russel/intro/reviewVideoCon_right.png) no-repeat right 50%;}
.session-wrap .session-prev{left:0;background:url(http://russeldata.megastudy.net/campus/images/russel/intro/reviewVideoCon_left.png) no-repeat left 50%;}


.session .session-info{}
.session .session-info div{cursor:pointer;width:160px !important;height:180px !important;border-radius:15px;background:#fff url(http://russeldata.megastudy.net/campus/images/russel/intro/2020/trophy.png) center  108px no-repeat;}
.session .session-info div p{padding-top:32px;font-size:16px;font-weight:400;text-align:center;}
.session .session-info div i{position:absolute;top:3px;left:3px;padding:0 10px 1px;border-radius:10px;background:#98a3d5;font-style:normal;font-weight:500;font-size:12px;color:#fff;}
.session .session-info div i.no-1{background:#7bbbdc;}
.session .session-info div strong{display:block;overflow:hidden;width:91%;margin:0 auto;font-size:18px;font-weight:700;color:#000;line-height:21px;white-space:nowrap;text-overflow:ellipsis;}
.session .session-info div span{display:block;overflow:hidden;width:95%;margin:0 auto;font-size:15px;font-weight:400;color:#7e7e7e;white-space:nowrap;text-overflow:ellipsis;}
