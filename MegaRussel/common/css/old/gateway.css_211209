/* 2017.09.05 리뉴얼 */
/* 인트로 공통 */
#gateway {position: relative}
#gateway .wrap_left_sky .left_sky{top:-5px;}
#gateway .wrap_right_sky{top:256px;}
#gateway .wrap_right_sky a {margin-top:0;margin-bottom:5px;display:block;}
/* #gateway .topSlide-wrap{display:none;} */
.header.gateway .headerTop .headerLeft{margin-top:9px;}

.gw_russel_wrap {width:1017px;margin:-5px auto 0 auto;padding-bottom:30px;}
.gw_russel_wrap .box_relative {position: relative}
.gw_russel_wrap h2 {width:100%;margin:35px 0 22px 0;padding-bottom:9px;font-weight:500;color:#000;font-size:17px;letter-spacing: -1px;border-bottom:1px solid #e0e0e0}
.gw_russel_wrap h3 {margin-bottom:17px;font-weight:500;color:#000;font-size:16px;letter-spacing: -1px;}
.gw_russel_wrap .clearfix:after {clear:both;display: block;content:""}

/* 20190326 추가 */
#gateway .wrap_right_sky a.uni_benner{position:relative;}
#gateway .wrap_right_sky a.uni_benner span{position:absolute;top:34px;left:42px;font-size:11px;color:#ffe975;font-weight:500;}

/* 상단 비주얼 */
.gw_russel_wrap a {text-decoration: none}
.gw_visual {width:1017px;height:313px;overflow: hidden;position: relative}
.gw_visual .cont {width:1017px;height:313px;overflow: hidden;position:relative}
.gw_visual .cont img {width:1017px;height:313px}
.gw_visual .cont .location_list_layer {padding:0 20px;width:153px;height:192px;position:absolute;top:44px;right:95px;background:#fff;}
.gw_visual .cont .location_list_layer:after {display: block;clear: both;content: ""}
.gw_visual .cont .location_list_layer .tit {padding-top: 25px;margin-bottom:18px;font-size:px;color:#484d4f;font-weight:500;letter-spacing: -1px;text-align:center;}
.gw_visual .cont .location_list_layer a {display:block;float:left;height:24px;margin-bottom:5px;line-height:1.7;color:#fff;background:#96999b;text-align:center;font-size:12px;}
.gw_visual .cont .location_list_layer.type01 a {width:100%;}
.gw_visual .cont .location_list_layer.type02 a {width:74px;}
.gw_visual .cont .location_list_layer.type02 a:nth-child(odd) {margin-left:5px;}
.gw_visual .cont .location_list_layer a:hover {background:#0081ff}
.gw_visual .owl-nav {font-size:0;z-index:5;}
.gw_visual .owl-nav div {height:57px;width:30px;position:absolute;}
.gw_visual .owl-nav .owl-prev {top:107px;left:25px;background: url("http://russeldata.megastudy.net/campus/images/russel/intro/2017/btn_visual_prev.png") left top no-repeat}
.gw_visual .owl-nav .owl-next {top:107px;right:25px;background: url("http://russeldata.megastudy.net/campus/images/russel/intro/2017/btn_visual_next.png") left top no-repeat}
.gw_visual .visual_nav {width:967px;position:absolute;top:256px;left:26px;z-index: 5;display: table;table-layout: fixed;border:1px solid #dbdfe0;}
.gw_visual .visual_nav li {display: table-cell;height:35px;line-height:35px;text-align: center;background: #f2f2f2;color:#414141;cursor: pointer;border-left: 1px solid #e1e1e1;width: 2%; letter-spacing: -1px;}
.gw_visual .visual_nav li:first-child {border-left:none}
.gw_visual .visual_nav li.active {background:#fff;color:#0081ff;font-weight:500}

/* 학원안내 */
.gw_russel_wrap .gw_tab_btn {position:absolute;top:2px;left:72px}
.gw_russel_wrap .gw_tab_btn li {float:left;color:#414141;margin-left:9px;font-size:13px;cursor:pointer;}
.gw_russel_wrap .gw_tab_btn li:hover, .gw_russel_wrap .gw_tab_btn li.on {color:#0081ff;}
.gw_russel_wrap .gw_tab_btn li:after {content:"|";width:10px;text-align:right;display: inline-block;color:#414141!important}
.gw_russel_wrap .gw_tab_btn li:last-child:after {content:""}
.gw_russel_wrap .gw_tab_con {display:none;height:127px;}
.gw_russel_wrap .gw_tab_con:after  {clear:both;display: block;content:""}
.gw_russel_wrap .gw_tab_con.on {display:block;}
.gw_russel_wrap .gw_tab_con .gw_news_banners {width:330px;float:left;}
.gw_russel_wrap .gw_tab_con .gw_news_banners a {width:135px;display: inline-block;text-align:center;letter-spacing: -1px;margin-left:14px;}
.gw_russel_wrap .gw_tab_con .gw_news_banners a span {display: block;margin-top:8px;}
.gw_russel_wrap .gw_notice {float:left;width:350px;position: relative;margin-top:3px}
.gw_russel_wrap .gw_notice li {padding-left:9px;margin-bottom:9px;position: relative;font-size:13px;color:#767676;background:url("http://russeldata.megastudy.net/campus/images/russel/intro/2017/bullet_gray.jpg") 2px 9px no-repeat;}
.gw_russel_wrap .gw_notice li a {display: inline-block;font-size:13px;width:340px;color:#767676;white-space: nowrap;overflow: hidden;text-overflow: ellipsis;letter-spacing: -1px;}
.gw_russel_wrap .gw_notice li .date {position: absolute;top:0px;right:0;letter-spacing: -1px;}
.gw_russel_wrap .btn_more {position:absolute;top:0px;right:0;}
.gw_russel_wrap .btn_more a {display:block;line-height:0;color:#000;font-size:20px;font-weight:500;width:350px;height:20px;text-align: right;line-height: 0.8;}
.gw_russel_wrap .gw_tap_study {float:right;margin-right:15px;width:297px;}

/* 러셀 학원 생활 Story&러셀 선배 생활 Story */
.gw_russel_wrap .gw_story {margin-bottom:45px;}
.gw_russel_wrap .gw_story .gw_class_stroy {width:508px;float:left;position: relative;height:220px;}
.gw_russel_wrap .gw_story .gw_senior_stroy {width:509px;float:left;position: relative}
.gw_russel_wrap .gw_story .russel_story {padding-left:33px;width:435px;}
.gw_russel_wrap .gw_story .russel_story .owl-nav .disabled {display:none;}
.gw_russel_wrap .gw_story .russel_story .owl-nav div {font-size:0;line-height: 0;width:10px;height:20px;}
.gw_russel_wrap .gw_story .russel_story .owl-nav .owl-prev {position: absolute;left:-25px;top:28px;background:url("http://russeldata.megastudy.net/campus/images/russel/intro/2017/btn_slide_prev.jpg") left top no-repeat;}
.gw_russel_wrap .gw_story .russel_story .owl-nav .owl-next {position: absolute;right:-13px;top:28px;background:url("http://russeldata.megastudy.net/campus/images/russel/intro/2017/btn_slide_next.jpg") left top no-repeat;}
.gw_russel_wrap .gw_story .russel_story .story_con {margin-right:15px;width:135px;height:118px;float:left;overflow: hidden;position: relative;text-align: center}
.gw_russel_wrap .gw_story .russel_story .story_con img {width:133px;height:73px;border:1px solid #c9c9c9;}
.gw_russel_wrap .gw_story .russel_story .story_con a {display:block}
.gw_russel_wrap .gw_story .russel_story .story_con a .paly_hover {position: absolute;top:0px;left:0px;}
.gw_russel_wrap .gw_story .russel_story .story_con a .paly_name {margin-top:10px;display: block;width:133px;overflow: hidden;text-overflow:ellipsis;white-space: normal;word-wrap: break-word;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient: vertical;}


/* gw_branch */
.gw_russel_wrap .gw_branch {background: #f2f2f2;padding:30px 28px 17px 28px;margin-bottom:45px;}
.gw_russel_wrap .gw_branch li {display: block;float:left;margin:0 6px 13px 6px;height:81px;width:225px;overflow:hidden;background: url("http://russeldata.megastudy.net/campus/images/russel/intro/2017/branch_bg.jpg") left top no-repeat;
    box-shadow:0px 0px 13px -1px rgba(172, 172, 172,.4);
    -webkit-box-shadow: 0px 0px 13px -1px rgba(172, 172, 172,.4);
    -moz-box-shadow: 0px 0px 13px -1px rgba(172, 172, 172,.4);
}
.gw_russel_wrap .gw_branch li a {padding-top:18px;height:63px;width:225px;display: block;background: #fff;text-align:center;background:url("http://russeldata.megastudy.net/campus/images/russel/intro/2017/btn_go.png") #fff right bottom no-repeat;}
.gw_russel_wrap .gw_branch li a:hover {width:223px;height:61px;border:1px solid #0081ff;background:url("http://russeldata.megastudy.net/campus/images/russel/intro/2017/btn_go_on.png") #e6f2ff right bottom no-repeat;}
.gw_russel_wrap .gw_branch li a:hover span.branch {margin:-1px 0 0 0}
.gw_russel_wrap .gw_branch li a:hover span.number {margin:2px 0 0 0}
.gw_russel_wrap .gw_branch li a span.branch {display: block;margin-bottom:2px;font-size:18px;color:#000;font-weight:500;letter-spacing: -2px}
.gw_russel_wrap .gw_branch li a span.branch strong {color:#0081ff;}
.gw_russel_wrap .gw_branch li a span.number {display: block;font-size:15px;color:#767676;}

/* 러셀블루TV배너 */
.gw_russel_wrap .bluetv_banner a {line-height: 0;font-size:0;}

/* 최상위권 수험생을 위한 러셀만의 학습전략 */
.gw_russel_wrap .gw_strategy {margin-bottom:-15px}
.gw_russel_wrap .gw_strategy ul {border-bottom:1px solid #e0e0e0;}
.gw_russel_wrap .gw_strategy ul:last-child {border-bottom:none;}
.gw_russel_wrap .strategy_01 {height:93px;}
.gw_russel_wrap .strategy_01 li {float:left;width:252px;padding:6px 0 6px 87px;color:#767676}
.gw_russel_wrap .strategy_01 li strong {display:block;font-size:15px;color:#000;margin-bottom:3px}
.gw_russel_wrap .strategy_01 li.str_01 {background: url("http://russeldata.megastudy.net/campus/images/russel/intro/2017/banner_bg01.jpg") 20px top no-repeat;}
.gw_russel_wrap .strategy_01 li.str_02 {background: url("http://russeldata.megastudy.net/campus/images/russel/intro/2017/banner_bg02.jpg") 20px top no-repeat;}
.gw_russel_wrap .strategy_01 li.str_03 {background: url("http://russeldata.megastudy.net/campus/images/russel/intro/2017/banner_bg03.jpg") 20px top no-repeat;}
.gw_russel_wrap .strategy_02 {height:90px;margin-top:29px}
.gw_russel_wrap .strategy_02 li:first-child {background: none}
.gw_russel_wrap .strategy_02 li {float:left;text-align: center;padding-left:20px;margin-right:15px;background: url("http://russeldata.megastudy.net/campus/images/russel/intro/2017/bullet_gray02.jpg") left center no-repeat;letter-spacing: -1px}
.gw_russel_wrap .strategy_02 strong {display:block;font-size:15px;color:#000;margin-bottom:13px}

/* 러셀 영통 Full 페이지 */

.gatewayFull .wrap_left_sky{display:none;}
.gatewayFull .wrap_right_sky{display:none;}
.gatewayFull .footer{width:100%;}
.gatewayFull .footer #megaMoreSite{}
.gatewayFull .footer #megaMoreSite li.lst{position:relative;top:auto;right:auto;}
.gatewayFull .footer #megaMoreSite #megagroup{left:50%;margin:0 0 0 -506px;}
.gatewayFull .footer .information{width:1016px;margin:0 auto;}
.gatewayFull iframe{height:0;}
.gatewayFull .yt_intro{min-height:500px;background:#aeaeae;}

.introMiddleBannerWrap{width:317px;position:absolute;top:970px;left:50%;margin:-330px 0 0 196px;}
.introMiddleBannerWrap .owl-dots{margin-top:-21px !important;position:relative;}
.introMiddleBannerWrap .btnClose{position:absolute;right:-6px;top:-23px;background:none;border:none;padding:0;}

/* 레이어 배너 슬라이드 버튼 active */
.owl-theme .owl-dots .owl-dot span {background-color:#869791!important}
.owl-theme .owl-dots .owl-dot.active span, .owl-theme .owl-dots .owl-dot:hover span {background-color:#D6D6D6}

/* Banner Middle */
.bannerMiddle{margin:20px 0 0 0;}
.introSmallBanner{width:297px;}
.introSmallBanner img{width:100%;}
.introSmallBanner .owl-dots{position:absolute;right:12px;top:12px;margin:0 0 0 0 !important;}
.introSmallBanner .owl-dots .owl-dot span{margin:0 3px !important;background-color:#000 !important;}
.introSmallBanner .owl-dots .owl-dot.active span{background-color:#dbdbdb !important;}

/* 개편 */
#gateway.gateway2018{min-width:1440px;}
#gateway.gateway2018 .wrap_left_sky{z-index:2;}
#gateway.gateway2018 .wrap_left_sky .left_sky{margin:0 0 0 -675px;top:440px;}
#gateway.gateway2018 .wrap_right_sky{z-index:12;width:100%;position:relative;margin:0;top:440px;left:auto;}
#gateway.gateway2018 .wrap_right_sky .right_sky{position:absolute;margin:0 -705px 0 0;top:1px;right:50%;width:130px;transform: none;}
#gateway.gateway2018 .header{width:1100px;padding:0 0 10px 0;}
#gateway.gateway2018 .russelNavi_2017{width:1098px;margin:0 -550px 0 0;top:127px;border-top:1px solid #0077ff;}

.gateway2018 .footer{width:100%;border-top:1px solid #515151;}
.gateway2018 .footer #megaMoreSite{background:#fff;margin:0 auto;width:1100px;border:none;text-align:left;padding:10px 0 9px 0;}
.gateway2018 .footer #megaMoreSite li.lst{position:relative;top:auto;right:auto;}
.gateway2018 .footer #megaMoreSite #megagroup{left:50%;margin:0 0 0 -550px;width:1100px;}
.gateway2018 .footer #megaMoreSite #megagroup #megagroup_list{margin:0 0 0 217px;}
.gateway2018 .footer #megaMoreSite #megagroup dd{background:none;}
.gateway2018 .footer #megaMoreSite #megagroup .prev{left:178px;}
.gateway2018 .footer #megaMoreSite #megagroup .next{right:46px;}
.gateway2018 .footer #megaMoreSite .clear_g .lst{float:right;}
.gateway2018 .footer #megaMoreSite .clear_g .lst:after{display:none;}
.gateway2018 .footer #megaMoreSite .clear_g .lst a{margin-right:18px;}
.gateway2018 .footer #megaMoreSite .clear_g li{position:relative;}
.gateway2018 .footer #megaMoreSite .clear_g li:first-child a{margin:0 6px 0 0}
.gateway2018 .footer #megaMoreSite .clear_g li:after{content:"";position:absolute;left:0;top:5px;width:1px;height:10px;background:#d9dbde;}
.gateway2018 .footer #megaMoreSite .clear_g li:first-child:after{display:none;}
.gateway2018 .footer #megaMoreSite .clear_g li a{margin-right:6px;}
.gateway2018 .footer .information{width:1100px;margin:0 auto;}
.gateway2018 .footer .information h1{vertical-align:middle; margin:0 35px;}
.gateway2018 .footer .information .con{vertical-align:middle;}
.gatewayWrap{color:#202020;}
.gatewayWrap a {color:#202020;outline:none;text-decoration:none;}
.gatewayWrap .visualArea{height:336px;border-bottom:1px solid #ececec;position:relative;}
.gatewayWrap .visualArea .visualOwl .item{height:336px;}
.gatewayWrap .visualArea .visualOwl .item .visual{width:644px;margin:0 0 0 -344px;height:100%;position:relative;left:50%;}
.gatewayWrap .visualArea .visualOwl .item .visual img{width:644px;}
.gatewayWrap .visualArea .visualCtrl{width:196px;height:100%;position:absolute;left:50%;top:0;margin:0 0 0 -550px;z-index:1;}
.gatewayWrap .visualArea .visualCtrl .visualOwlTab li{width:120px;height:55px;border-bottom:1px solid #eee;color:#8b8d8f;}
.gatewayWrap .visualArea .visualCtrl .visualOwlTab li:first-child{margin:0 0 0 0;}
.gatewayWrap .visualArea .visualCtrl .visualOwlTab li:nth-of-type(6) {height:56px;border-bottom:none;}
.gatewayWrap .visualArea .visualCtrl .visualOwlTab li.russel_yj {height:56px;width:120px!important;}
/* .gatewayWrap .visualArea .visualCtrl .visualOwlTab li + li + li + li{height:55px;} */
.gatewayWrap .visualArea .visualCtrl .visualOwlTab li > a{display:table;width:100%;height:100%;outline:none;}
.gatewayWrap .visualArea .visualCtrl .visualOwlTab li > a > .tableCell{display:table-cell;vertical-align:middle;font-size:13px;line-height:15px;padding:0 20px 0 15px;background:#f9fcfa;}
.gatewayWrap .visualArea .visualCtrl .visualOwlTab li .list{width:82px;height:100%;position:absolute;left:120px;top:0;background:#fff;display:none;border-left:1px solid #eee;border-right:1px solid #eee;}
.gatewayWrap .visualArea .visualCtrl .visualOwlTab li .list .title{background:#b4b6b8;text-align:center;color:#fff;font-size:px;font-size:12px;line-height:30px;display:block;}
.gatewayWrap .visualArea .visualCtrl .visualOwlTab li .list .listBox{display:table;width:100%;height:305px;}
.gatewayWrap .visualArea .visualCtrl .visualOwlTab li .list .listBox .tableCell{display:table-cell;vertical-align:middle;}
.gatewayWrap .visualArea .visualCtrl .visualOwlTab li .list .listBox a{display:block;height:auto;line-height:24px;font-size:13px;color:#8b8d8f;text-align:center;}
.gatewayWrap .visualArea .visualCtrl .visualOwlTab li .list .listBox a:hover{color:#0081ff;}
.gatewayWrap .visualArea .visualCtrl .visualOwlTab li .list .listBox a:active{color:#0081ff;}
.gatewayWrap .visualArea .visualCtrl .visualOwlTab li.active > a{font-weight:500;color:#202020;}
.gatewayWrap .visualArea .visualCtrl .visualOwlTab li.active > a > .tableCell{background:#fff url("http://russeldata.megastudy.net/campus/images/russel/intro/arrow_visual_tab.png") no-repeat 102px 50%;}
.gatewayWrap .visualArea .visualCtrl .visualOwlTab li.active .list{display:block;}
.gatewayWrap .visualArea .visualCtrl .visualOwlTab li.none .list{display:none !important;}

.gatewayWrap .visualArea .visualRightBanner{width:250px;height:270px;position:absolute;right:50%;top:50%;margin-top:-135px;margin-right:-550px;}
.gatewayWrap .visualArea .visualRightBanner .owl-stage-outer{border-radius:12px;box-shadow:8px 8px 13px rgba(0,0,0,0.15);height:270px;}
.gatewayWrap .visualArea .visualRightBanner img{height:auto;}

.gatewayWrap .visualArea .visualRightBanner .owl-dots{position:absolute;top:10px;right:25px;}
.gatewayWrap .visualArea .visualRightBanner .owl-dot {display:none!important;background:none!important;padding:0;border:none;}
.gatewayWrap .visualArea .visualRightBanner .owl-dot.active {display:block!important;background:none!important;}
.gatewayWrap .visualArea .visualRightBanner .owl-dots .owl-dot span {font-size:11px;display:inline-block;width:auto!important;height:auto!important;background-color:transparent!important;margin:0!important;color:#5f5f5f;}
.gatewayWrap .visualArea .visualRightBanner .owl-dots .owl-dot span.on{padding-left:2px;color:#9e9e9e;}

.gatewayWrap .visualArea .visualRightBanner .owl-nav {width:40px !important;position:absolute;top:15px;right:15px;background:none;width:auto;height:auto;margin-top:0;z-index: 1;}
.gatewayWrap .visualArea .visualRightBanner .owl-nav button {float:left;font-size:0!important;background:none;margin:0;padding:0!important;width:5px;height:8px;border:none;}
.gatewayWrap .visualArea .visualRightBanner .owl-nav button:nth-of-type(1){background:url("http://russeldata.megastudy.net/campus/images/russel/banner/2021/left_prev.png") left top no-repeat}
.gatewayWrap .visualArea .visualRightBanner .owl-nav button:nth-of-type(2){float:right;background:url("http://russeldata.megastudy.net/campus/images/russel/banner/2021/right_next.png") left top no-repeat}

.left_sky .left-sky-slide .owl-dot{margin:0 auto;padding:0;border:none;}
.left_sky .left-sky-slide .owl-nav button {float:left;font-size:0!important;background:none;margin:0;padding:0!important;width:5px;height:8px;border:none;}
.left_sky .left-sky-slide .owl-nav button:nth-of-type(1) {margin-left:20px;background:url("http://russeldata.megastudy.net/campus/images/russel/banner/2021/left_prev.png") left top no-repeat}
.left_sky .left-sky-slide .owl-nav button:nth-of-type(2) {margin-right:20px;float:right;background:url("http://russeldata.megastudy.net/campus/images/russel/banner/2021/right_next.png") left top no-repeat}



/*.gatewayWrap .visualArea .visualRightOwl .owl-dots{margin:0 0 0 0 !important;text-align:right;position:absolute;right:11px;top:12px;line-height:8px;}
.gatewayWrap .visualArea .visualRightOwl .owl-dots .owl-dot span{width:8px;height:8px;background:#fff !important;margin:0 2px;vertical-align:top;opacity:0.5;font-size:0;}
.gatewayWrap .visualArea .visualRightOwl .owl-dots .owl-dot.active span{opacity:1;}*/

.gatewayWrap .fixBanner{height:83px;border-bottom:1px solid #ececec;}
.gatewayWrap .fixBanner ul{width:1100px;height:100%;margin:0 auto;overflow:hidden;}
.gatewayWrap .fixBanner ul li{width:25%;height:100%;line-height:22px;border-right:1px solid #ececec;float:left;box-sizing:border-box;font-size:13px;color:#8b8d8f;letter-spacing:-1px;}
.gatewayWrap .fixBanner ul li:first-child{border-left:1px solid #ececec;}
.gatewayWrap .fixBanner ul li a{padding:19px 0 0 85px;display:block;height:64px;}
.gatewayWrap .fixBanner ul li.list_1{background:url("http://russeldata.megastudy.net/campus/images/russel/intro/icon_fix_study.png") no-repeat 28px 55%;}
