/* 러셀 스튜디오 */
.playlist-wrap {position: relative;height:265px}
.playlist-wrap .tab-bt a {padding:0 12px 0 0;margin:0 15px 0 0;display:inline-block;position:relative;font-size:20px;font-weight:500;color:#a8a8a8;}
.playlist-wrap .tab-bt a::after {content: "";position:absolute;top:8px;right:-4px;display:block;height:17px;width:1px;background:#c0c0c0}
.playlist-wrap .tab-bt a:last-child::after {display: none;}
.playlist-wrap .tab-bt a.on {color:#333}
.playlist-wrap .tab-cont {position: absolute;top:45px;left:0;width:100%;height:160px;background:#fff;z-index: 0;}
.playlist-wrap .tab-cont.on {z-index: 1;}