<script>
    $(document).ready(function(){
        teacherSlide01()

        $(".bc .teacher-sub-list").each(function(elem, target){
            var swp01 = target.swiper;
            $(this).hover(function() {
                swp01.autoplay.stop();
            }, function() {
                swp01.autoplay.start();
            });
        });
    })

    function teacherSlide01(){
        var tSwiper01 = new Swiper('.bc .teacher-sub-list' ,{
            // allowTouchMove: false,
            autoplay: {
                delay: 0,
                disableOnInteraction: false,
            },
            centeredSlidesBounds: true,
            loop:true,
            speed: 2700,
		    slidesPerView: 'auto',
            spaceBetween: 40,
        });
    }
</script>