    function teacherSlide(){
        var tSwiper = new Swiper('.teacher-sub-list' ,{
            // allowTouchMove: false,
            autoplay: {
                delay: 0,
                disableOnInteraction: false,
            },
            centeredSlidesBounds: true,
            loop:true,
            speed: 2700,
		    slidesPerView: 'auto',
            spaceBetween: 40,
        });
    }
</script>