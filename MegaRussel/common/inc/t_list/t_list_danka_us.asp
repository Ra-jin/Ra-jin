<script>   
    $(document).ready(function(){
        tDankSlide()
    }) 

    $(function(){

        var $bt_t    = $('.tab-subject a');
        var $cont_t  = $('.teacher-wrap .list-wrap');

        $bt_t.on('click',function(e){
            e.preventDefault();
            var idx = $(this).index()

            $(this).addClass('on').siblings().removeClass('on')
            $cont_t.eq(idx).addClass('on').siblings().removeClass('on')
        })
        
    })

    function tDankSlide(){

        $(".teacher-sub-list").each(function(index){
            var $this = $(this);
            var t_Slide = $this.addClass("js-t-slide-" + parseInt(index+1));
            var $slide = t_Slide.children().find('.swiper-slide');            

	        if($slide.length >= 4){
                var tSwiper = new Swiper(t_Slide ,{
                    autoplay: {
                        delay: 6000,
                        disableOnInteraction: false,
                        pauseOnMouseEnter: true,
                    },
                    loop:true,
                    speed: 500,
                    slidesPerView: '3',
                    spaceBetween: 20,
                    navigation: {
                        nextEl: '.swiper-button-next',
                        prevEl: '.swiper-button-prev',
                    },
                    observer: true,
                    observeParents: true,
                });               
            }else{
                var tSwiper = new Swiper(t_Slide, {
                    slidesPerView: '3',
                    loop:false,
                    allowTouchMove: false,
                    autoplay:false,
                    navigation: false,
                    observer: true,
                    observeParents: true,
                });
                t_Slide.children('.swiper-button-prev, .swiper-button-next').css('display','none')
            }            
        });
    }
</script>