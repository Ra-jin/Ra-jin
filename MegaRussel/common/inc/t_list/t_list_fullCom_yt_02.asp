<script>
    $(document).ready(function(){
        teacherSlide03()

        $(".teacher-sub-list").each(function(elem, target){
            var swp03 = target.swiper;
            $(this).hover(function() {
                swp03.autoplay.stop();
            }, function() {
                swp03.autoplay.start();
            });
        });
    })

    function teacherSlide03(){
        var tSwiper03 = new Swiper('.teacher-sub-list' ,{
            // allowTouchMove: false,
            autoplay: {
                delay: 0,
                disableOnInteraction: false,
            },
            centeredSlidesBounds: true,
            loop:true,
            speed: 2700,
		    slidesPerView: 'auto',
            spaceBetween: 40,
        });
    }


</script>