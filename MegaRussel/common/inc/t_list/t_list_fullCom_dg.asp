<script>   
    $(document).ready(function(){
        teacherSlide02()
        
        $(".dg .teacher-sub-list").each(function(elem, target){
            var swp02 = target.swiper;
            $(this).hover(function() {
                swp02.autoplay.stop();
            }, function() {
                swp02.autoplay.start();
            });
        });
    }) 

    function teacherSlide02(){
        var tSwiper02 = new Swiper('.dg .teacher-sub-list' ,{
            // allowTouchMove: false,
            autoplay: {
                delay: 0,
                disableOnInteraction: false,
            },
            centeredSlidesBounds: true,
            loop:true,
            speed: 2700,
		    slidesPerView: 'auto',
            spaceBetween: 40,
        });
    }
    // 적용 페이지별 변경사항
    $(function() {
        
        var path_name = $(location).attr('pathname');

        //썸머스쿨
        if(path_name.indexOf("/summer_overall/") > -1){
            //박석준t 순서변경
            $(".t-psj01").css("display", "block")
            $(".t-psj02").css("display", "none")
            // 정낙훈t 삭제
            $(".t-jnh").css("display", "none")
        }
    })
</script>