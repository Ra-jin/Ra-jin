            var link_first02 = campus_link + 'intro/2024/first/index.asp';        //재수생우선선발반
            var link_first03 = campus_link + 'intro/2025/first/index.asp';        //2026 재수생우선선발반
            var link_regular = campus_link + 'intro/2023/regular/index.asp';  
            var link_regular02 = campus_link + 'intro/2024/regular/index.asp';  //N수정규반
            var link_regular03 = campus_link + 'intro/2025/regular/index.asp';  //N수정규반
            var link_quel = campus_link + 'event/2021/quel/index.asp';    //퀄
            var link_quel_unit = campus_link + 'event/2024/quel_unit/index.asp';    //퀄2024
            var link_quel02 = campus_link + 'event/quel_all/quel/index.asp';    //퀄 모의고사
            var link_equel = campus_link + 'event/2024/equel/index.asp';    //E퀄 2024
            var link_premium = campus_link + 'intro/2022/premium/index.asp';    //메대프
            var link_regular_go = campus_link + 'intro/2023/regular_go/index.asp';    //재학생정규반
            var link_regular_go_2025 = campus_link + 'intro/2024/regular_go/index.asp';    //재학생정규반2025
            var link_regular_go_2026 = campus_link + 'intro/2025/regular_go/index.asp';    //재학생정규반2026
            var link_weekly = campus_link + 'intro/2022/weekly/index.asp';    //위클리
            var link_half = campus_link + 'intro/2023/half/index.asp';    //2024 반수반
            var link_half02 = campus_link + 'intro/2024/half/index.asp';    //2025 반수반
            var link_half03 = campus_link + 'intro/2025/half/index.asp';    //2026 반수반
