    <script>    
        var rSwiper = new Swiper('.student-result-swiper',{
            autoplay: {
                delay: 0,
                disableOnInteraction: false,
            },
            loop:true,
            speed: 2500,
            grabCursor: true,
            slidesPerView: 'auto',
            spaceBetween: 40
        });

        $('.student-result-swiper').hover(function(){
                rSwiper.autoplay.stop()
            },function(){
                rSwiper.autoplay.start()
            }
        )
    </script>