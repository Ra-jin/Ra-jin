<div class="js-cont-wrap <%=campusName%>">

    <div class="cont11 js-cont">
        <h3><img src="<%=Application("img_path_russel")%>/m_russel/<%=campusName%>/2025/half/cont11_tit.jpg" alt="수능 시간표를 따라가는 최상위권 전문관 표준 일과표 실전 감각 최적화 가능" /></h3>
    
        <div class="inner">
            <div class="time-slide swiper-container">
