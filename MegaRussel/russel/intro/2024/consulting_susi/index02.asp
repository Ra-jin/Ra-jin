<script>
	
	// 온라인 문의 팝업
	function fn_qnaGo() {
		var userAgent = navigator.userAgent.toLowerCase();
    	var isMobileOrTablet = /iphone|ipod|ipad|android|blackberry|mini|windows\sce|palm/i.test(userAgent);
    
		<% If gLoginOk = false Then %>
			alert("로그인 후 이용가능합니다.");
			if (isMobileOrTablet) {
				location.href="https://mrussel.megastudy.net/member/login.asp?rtnUrl=https%3A%2F%2Fmrussel%2Emegastudy%2Enet%2Fboard%2Fconsult_write%2Easp?mode=consult_qna"
			} else {
				location.href="/russel/member/login.asp?rtnUrl=%2Frussel%2Finfo%2Fqna%2Fqna_write%2Easp?mode=consult_qna"
			}
			return;
		<% else %>
			if (isMobileOrTablet) {
				window.open('https://mrussel.megastudy.net/board/consult_write.asp?mode=consult_qna')
			} else {
				window.open('/russel/info/qna/qna_write.asp?mode=consult_qna')
			}
		<% End If %>

	}
	

	//상세 정보 등록 확인
	function fn_historyGo(){
		window.open('./popup.asp','online_reg','scrollbars=yes,width=857,height=1500,top=0');
	}

	// 대학검색 팝업
	(function($){
		$.fn.placeholder = function(){
			return this.each(function(){
				var root = $(this);
				root.find('input').focusin(function(){
					$(this).closest(root).find('label').hide();
				});
				root.find('input').focusout(function(){
					if($(this).val().length == 0){
						$(this).closest(root).find('label').show();
					};
				});
				if(root.find('input').val().length > 0){
					root.find('label').hide();
				};
			});
		};
		$('.searchBox').placeholder();
	})(jQuery);

	
	// 로그인 연결
	function fn_loginGo() {
		
		<% If gLoginOk = false Then %>
			alert("로그인 후 이용가능합니다.");
			location.href="/russel/member/login.asp?rtnUrl=%2Frussel%2Finfo%2Fqna%2Fqna_write%2Easp?mode=consult_qna"
			return;
		<% else %>
			window.open('/intro/2024/consulting_susi/index.asp')
		<% End If %>

	}


    //aos fadeup 효과
    AOS.init({
                
		offset: 200,
		duration: 500,
		easing: 'ease-in-sine',
		delay: 0,
		once: true
	});
	
        /*======== 캘린더 년월 변화 ========*/
        // 현재 날짜를 기준으로 초기화
        let currentDate = new Date(2024, 6); // 2024년 8월은 7월 (0이 1월)

        function updateCalendarTitle() {
            const year = currentDate.getFullYear();
            const month = currentDate.getMonth() + 1; // getMonth()는 0부터 시작하므로 +1
            $('#calender_title').text(year + '년 ' + month + '월');
        }

        function preMonth() {
            //년월변화
            currentDate.setMonth(currentDate.getMonth() - 1);
            updateCalendarTitle();
            
            //달력변화
            var $currentActive = $('tbody:not(.non-active)');
            var $prevActive = $currentActive.prev('tbody');
            
            if ($prevActive.length) {
                $currentActive.addClass('non-active');
                $prevActive.removeClass('non-active');
            }
        }
        function nextMonth() {
            //년월변화
            currentDate.setMonth(currentDate.getMonth() + 1);
            updateCalendarTitle();
            //달력변화
            var $currentActive = $('tbody:not(.non-active)');
            var $nextActive = $currentActive.next('tbody');
            
            if ($nextActive.length) {
                $currentActive.addClass('non-active');
                $nextActive.removeClass('non-active');
            }
        }

        // 초기 캘린더 타이틀 업데이트
        updateCalendarTitle();
        /*//======== 캘린더 년월 변화 ========*/
		
</script>
